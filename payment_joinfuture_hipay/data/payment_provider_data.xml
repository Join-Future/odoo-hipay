<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_provider_hipay" model="payment.provider">
        <field name="name">HiPay by Join Future</field>
        <field name="code">hipay</field>
        <field name="image_128" type="base64" file="payment_joinfuture_hipay/static/description/icon.png"/>
        <field name="module_id" ref="base.module_payment_joinfuture_hipay"/>
        <field name="redirect_form_view_id" ref="redirect_form"/>
        <field name="payment_method_ids"
               eval="[Command.set([
                         ref('payment.payment_method_card'),
                         ref('payment.payment_method_benefit'),
                     ])]"
        />
        <field name="pre_msg" type="html">
            <p>You will be sent to HiPay by Join Future to pay securely.</p>
        </field>
    </record>

</odoo>
